@page "/"
@page "/Piano"

@implements IDisposable

@inject IJSRuntime JS

<PageTitle>Metronome</PageTitle>


<div class="metronome-container">

    <h1>Metronome</h1>


    <div class="bpm-display">

        <div class="bpm-number">
            @Bpm
        </div>

        <div class="bpm-label">
            BPM
        </div>

    </div>


    <div class="beat-display">
        Beat @CurrentBeat / @BeatsPerMeasure
    </div>


    <div class="beat-indicator">
        <div class="beat @(Running ? "active" : "")"></div>
    </div>



    <div class="tempo-controls">

        <button class="tempo-button"
                @onclick="() => ChangeTempo(-10)">
            -10
        </button>


        <button class="tempo-button"
                @onclick="() => ChangeTempo(-1)">
            -1
        </button>


        <button class="tempo-button"
                @onclick="() => ChangeTempo(1)">
            +1
        </button>


        <button class="tempo-button"
                @onclick="() => ChangeTempo(10)">
            +10
        </button>

    </div>



    <input type="range"
           min="40"
           max="220"
           value="@Bpm"
           @oninput="TempoChanged"
           class="tempo-slider" />



    <div class="setting">

        <label>
            Time Signature
        </label>

        <select value="@BeatsPerMeasure"
        @onchange="TimeSignatureChanged">

            <option value="2">
                2 / 4
            </option>

            <option value="3">
                3 / 4
            </option>

            <option value="4">
                4 / 4
            </option>

            <option value="6">
                6 / 8
            </option>

        </select>

    </div>



    <div class="setting">

        <label>
            Volume
        </label>


        <input type="range"
               min="0"
               max="1"
               step="0.05"
               value="@Volume"
               @oninput="VolumeChanged"
               class="tempo-slider" />

    </div>




    <button class="start-button @(Running ? "stop" : "")"
            @onclick="ToggleMetronome">

        @(Running ? "■ Stop" : "▶ Start")

    </button>



</div>



@code {

    private int Bpm = 85;

    private bool Running;


    private int BeatsPerMeasure = 4;

    private int CurrentBeat = 1;


    private double Volume = 0.5;



    private async Task ToggleMetronome()
    {

        Running = !Running;


        if (Running)
        {
            await JS.InvokeVoidAsync(
                "metronome.start",
                Bpm,
                BeatsPerMeasure,
                Volume);
        }
        else
        {
            await JS.InvokeVoidAsync(
                "metronome.stop");
        }

    }



    private async Task ChangeTempo(int amount)
    {

        Bpm += amount;


        if (Bpm < 40)
            Bpm = 40;


        if (Bpm > 220)
            Bpm = 220;



        if (Running)
        {
            await JS.InvokeVoidAsync(
                "metronome.setTempo",
                Bpm);
        }

    }



    private async Task TempoChanged(
        ChangeEventArgs e)
    {

        Bpm =
            int.Parse(e.Value!.ToString()!);


        if (Running)
        {
            await JS.InvokeVoidAsync(
                "metronome.setTempo",
                Bpm);
        }

    }



    private async Task TimeSignatureChanged(
        ChangeEventArgs e)
    {

        BeatsPerMeasure =
            int.Parse(e.Value!.ToString()!);


        await JS.InvokeVoidAsync(
            "metronome.setBeatsPerMeasure",
            BeatsPerMeasure);

    }



    private async Task VolumeChanged(
        ChangeEventArgs e)
    {

        Volume =
            double.Parse(e.Value!.ToString()!);


        await JS.InvokeVoidAsync(
            "metronome.setVolume",
            Volume);

    }


    public void Dispose()
    {

    }

}